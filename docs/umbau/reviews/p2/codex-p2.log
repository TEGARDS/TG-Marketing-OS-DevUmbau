220:    ...ls(join(ROOT, ".claude/skills"), (n) => existsSync(join(ROOT, ".claude/skills", n, "SKILL.md"))),
221:    ...ls(join(GLOBAL, "skills"), (n) => existsSync(join(GLOBAL, "skills", n, "SKILL.md"))),
222:  ]);
223:  const rules = new Set(

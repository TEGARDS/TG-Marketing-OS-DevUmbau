300:type Paket = { id: string; dateien: Quelle[]; zeichen: number };
301:
302:const packen = (quellen: Quelle[], budget: number): Paket[] => {
303:  const steuerung = quellen.filter((q) => q.schicht === "steuerung");
304:  const rest = quellen.filter((q) => q.schicht !== "steuerung");
305:  const bezug = steuerung.reduce((n, q) => n + q.zeichen, 0);
306:  const frei = Math.max(budget - bezug, 60_000);
307:  const einheiten = new Map<string, Quelle[]>();
308:  for (const q of rest) (einheiten.get(q.einheit) ?? einheiten.set(q.einheit, []).get(q.einheit)!).push(q);
309:  const pakete: Paket[] = [{ id: "A-steuerung", dateien: steuerung, zeichen: bezug }];
310:  let akt: Quelle[] = [];
311:  let n = 0;
312:  const schliessen = () => {
313:    if (!akt.length) return;
314:    const i = pakete.length;
315:    const buchstabe = i < 26 ? String.fromCharCode(65 + i) : `${String.fromCharCode(64 + Math.floor(i / 26))}${String.fromCharCode(65 + (i % 26))}`;
316:    const id = `${buchstabe}-${akt[0].einheit.replace(/[:]/g, "-")}`;
317:    pakete.push({ id, dateien: akt, zeichen: n });
318:    akt = [];
319:    n = 0;
320:  };
321:  for (const [, qs] of einheiten) {
322:    const groesse = qs.reduce((s, q) => s + q.zeichen, 0);
323:    if (n + groesse > frei) schliessen();
324:    for (const q of qs) {
325:      if (n + q.zeichen > frei && akt.length) schliessen();
326:      akt.push(q);
327:      n += q.zeichen;
328:    }
329:  }
330:  const letzter = akt;
331:  if (pakete.length > 1 && n < frei / 10) {
332:    const vorher = pakete[pakete.length - 1];
333:    vorher.dateien.push(...letzter);
334:    vorher.zeichen += n;
335:    akt = [];
336:  }
337:  schliessen();
338:  return pakete;
339:};

1:#!/usr/bin/env bash
2:# One video in, readable material out: transcript plus keyframes.
3:# Usage: material-zu-text.sh <video> [zielordner] [sekunden-je-keyframe]
4:set -euo pipefail
5:
6:VIDEO="${1:?usage: material-zu-text.sh <video> [outdir] [frame-interval-seconds]}"
7:OUT="${2:-$(dirname "$VIDEO")/$(basename "${VIDEO%.*}")-text}"
8:EVERY="${3:-20}"
9:# Optional external dependency (nicht in diesem Paket enthalten): the media-use skill (HyperFrames), or any
10:# script with the same --input/--out contract via TRANSCRIBE=<path>.
11:TRANSCRIBE="${TRANSCRIBE:-$HOME/.claude/skills/media-use/scripts/transcribe.mjs}" # optional, nicht in diesem Paket enthalten
12:
13:command -v ffmpeg >/dev/null || { echo "ffmpeg fehlt: brew install ffmpeg" >&2; exit 1; }
14:[ -f "$TRANSCRIBE" ] || { echo "Transkription fehlt: optionalen Skill media-use (nicht in diesem Paket enthalten) installieren oder TRANSCRIBE=<pfad> setzen ($TRANSCRIBE)" >&2; exit 1; }
15:
16:mkdir -p "$OUT/frames"
17:BASE="$OUT/$(basename "${VIDEO%.*}")"
18:
19:# 16 kHz mono is what the ASR models expect; anything richer is thrown away anyway.
20:ffmpeg -nostdin -loglevel error -i "$VIDEO" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$BASE.wav" -y
21:
22:# Keyframes carry what speech does not: menus, clicks, settings. Screencasts need them.
23:ffmpeg -nostdin -loglevel error -i "$VIDEO" -vf "fps=1/$EVERY,scale=1280:-2" -q:v 4 \
24:  "$OUT/frames/frame-%03d.jpg" -y
